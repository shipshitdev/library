{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["bun-types"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["check-plan.mjs", "check-plan.test.ts"]
}
